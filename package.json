{
  "name": "lab1-svg-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Object-oriented SVG command-line editor for Lab1 Phase 1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "cli": "tsc -p tsconfig.json && node dist/src/main.js",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  }
}
